{
  "name": "koi-ascii",
  "version": "0.3.0",
  "description": "An ASCII-art koi pond for page backgrounds. WebGL2, no dependencies.",
  "keywords": [
    "koi",
    "ascii",
    "ascii-art",
    "pond",
    "background",
    "webgl",
    "webgl2",
    "animation",
    "shader"
  ],
  "homepage": "https://luckmorecat.github.io/koi-ascii/",
  "bugs": {
    "url": "https://github.com/Luckmorecat/koi-ascii/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luckmorecat/koi-ascii.git"
  },
  "license": "MIT",
  "author": "Luckmorecat",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test:browser": "playwright test",
    "shot": "node --experimental-strip-types scripts/shot.mjs",
    "shots": "node --experimental-strip-types scripts/shots.mjs",
    "perf": "node --experimental-strip-types scripts/perf.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
